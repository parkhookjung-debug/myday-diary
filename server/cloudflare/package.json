{
  "name": "myday-free-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/local-dev.mjs",
    "dev:lan": "node tools/local-dev.mjs --lan",
    "types": "wrangler types --include-runtime=false",
    "check": "tsc --noEmit",
    "test": "vitest run && node --test test/free-deploy.test.mjs",
    "build": "wrangler deploy --dry-run --outdir .test-worker",
    "test:native": "node tools/test-native.mjs",
    "deploy": "node tools/free-deploy.mjs",
    "check:free": "node tools/free-deploy.mjs --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "miniflare": "5.20261012.1-beta",
    "typescript": "~5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "4.151.1"
  }
}
